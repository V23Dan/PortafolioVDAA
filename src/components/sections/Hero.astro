---
import Logo from "../icons/logo.png";
import linkedin from "../icons/linkedin.svg";
import github from "../icons/github.svg";
---

<section class="hero" id="Hero">
  <div class="hero-content">
    <div class="hero-info">
      <h2>¡HOLA!, mi nombre es:</h2>

      <h1 class="nombre">Victor Danilo Alvarez Alvarez</h1>
      <p>
        Estudiante de ingeniería de sistemas, entusiasta por el desarrollo web.
        ¡Explora mi portafolio y conoce más sobre mi
        trabajo y proyectos!
      </p>
      <button class="button-cv">Descargar CV</button>
    </div>
    <div class="hero-card">
      <div class="logoBox">
        <img src={Logo.src} alt="logo" class="logoVDAA" />
      </div>
      <div class="box-redes">
        <a href="https://www.linkedin.com/in/victor-danilo-alvarez-alvarez-130814330" class="redes" target="_blank" rel="noopener noreferrer">
          <img src={linkedin.src} alt="Logo de LinkedIn" class="logosRedes" />
        </a>
        <a href="https://github.com/V23Dan" class="redes" target="_blank" rel="noopener noreferrer">
          <img src={github.src} alt="Logo de Github" class="logosRedes" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    min-height: 100vh;
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  h2 {
    color: var(--color-secondary);
    font-weight: 500;
    font-size: 1.5rem;
  }
  p{
    margin-top: 15px;
    line-height: 1.4;
    font-size: 1.1rem;  }

  .hero-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    width: 100%; 
    max-width: 1000px;
    margin: 0 auto; 
  }

  .hero-info {
    width: 50%;
    font-size: 18px;
    color: white;
  }

  .button-cv {
    margin-top: 10px;
    padding: 10px 22px;
    background-color: var(--color-background);
    color: var(--color-text);
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid rgba(110, 172, 218, 0.3);
    transition: background-color 250ms ease-in-out;
  }

  .button-cv:hover {
    background-color: var(--color-primary);
    color: white;
  }

  .hero-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 40%;
    height: 400px;
    background-color: #09243a;
    border: 1px solid rgba(110, 172, 218, 0.3);
    box-shadow: inset 0 0 20px 2px var(--color-background);
    padding: 15px;
    border-radius: 25px;
    transition: all 400ms linear;
  }

  .hero-card:hover {
    box-shadow: inset 0 0 15px #ffffff;
  }

  .nombre {
    font-size: 2.3rem;
    margin: 10px 0;
    color: var(--color-text);
  }

  .logoVDAA {
    width: 200px;
    height: 200px;
    border-radius: 100%;
    z-index: 2;
  }

  .box-redes {
    width: 100%;
    gap: 25px;
    display: flex;
    justify-content: center;
  }

  .redes {
    width: 40px;
    height: 40px;
    padding: 10px;
    border-radius: 100%;
    transition: all 250ms ease-in-out;
  }

  .logosRedes {
    width: 100%;
    height: 100%;
    filter: invert(1);
  }

  .redes:hover {
    background-color: var(--color-primary);
    translate: 0 -3px;
  }

  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .logoBox {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .logoBox::after,
  .logoBox::before {
    content: "";
    position: absolute;
    height: 200px;
    width: 200px;
    background-image: conic-gradient(
      from var(--angle),
      #03346e,
      #6eacda,
      #e2e2b6
    );
    padding: 3px;
    border-radius: 100%;
    z-index: 1;
    animation: 3s spin linear infinite;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .logoBox::before {
    filter: blur(1.5rem);
    opacity: 0.7;
  }

  @keyframes spin {
    from {
      --angle: 0deg;
    }
    to {
      --angle: 360deg;
    }
  }

  @media(width < 1200px) {
    .hero-content {
      width: 90%; /* Ajustado para mejor uso del espacio */
    }
  }

  @media (width <= 900px) {
    .hero-content{
      width: 85%;
      justify-content: center;
    }
  }

  @media (width <= 700px) {
    .hero {
      padding: 0 10px; /* Reduce el padding en móviles */
    }
    
    .hero-content{
        width: 100%;
        margin-top: 70px;
        flex-direction: column;
    }

    .hero-info {
      width: 90%; /* Aumentado para mejor legibilidad */
      text-align: center;
      font-size: 16px;
    }

    .nombre {
      font-size: 2rem;
    }

    .hero-card {
      width: 90%; /* Aumentado para consistencia */
      height: auto;
      padding: 25px 15px;
      gap: 20px;
      flex-direction: column;
    }
  }

  @media (width <= 400px) {
    .logoBox{
        width: 150px;
        height: 150px;
    }

    .logoBox::after, .logoBox::before{
        width: 150px;
        height: 150px;
    }

    .logoVDAA{
        width: 150px;
        height: 150px;
    }
  }
</style>