---
import github from "../icons/Github.svg";
import astro from "../icons/astro.svg";
import angular from "../icons/angular.svg";
import react from "../icons/react.svg";
import nodejs from "../icons/nodejs.svg";
import laravel from "../icons/laravel.svg";
import postgresql from "../icons/postgresql.svg";
import mongodb from "../icons/mongodb.svg";
import mysql from "../icons/mysql.svg";

const skills = [
  //Herramientas
  {
    name: "GitHub",
    icon: github,
    category: "Tools",
  },
  //Frontend
  {
    name: "Astro",
    icon: astro,
    category: "Frontend",
  },
  {
    name: "Angular",
    icon: angular,
    category: "Frontend",
  },
  {
    name: "React",
    icon: react,
    category: "Frontend",
  },
  //Backend
  {
    name: "Node.js",
    icon: nodejs,
    category: "Backend",
  },
  {
    name: "Laravel",
    icon: laravel,
    category: "Backend",
  },
  //Bases de datos
  {
    name: "PostgreSQL",
    icon: postgresql,
    category: "Base de datos",
  },
  {
    name: "MongoDB",
    icon: mongodb,
    category: "Base de datos",
  },
  {
    name: "MySQL",
    icon: mysql,
    category: "Base de datos",
  },
];
---

<section>
  <div class="skills-content">
    <header class="header-skills">
      <h1>Habilidades y herramientas</h1>
      <div class="box-filters">
        <label for="skillFilter">Filtrar</label>
        <select name="filtros" id="skillFilter" class="filters">
          <option value="Todos">Todos</option>
          <option value="Backend">Backend</option>
          <option value="Frontend">Frontend</option>
          <option value="Base de datos">Base de datos</option>
          <option value="Tools">Herramientas</option>
        </select>
      </div>
    </header>

    <div class="content-skills" id="skillsContainer">
      {
        skills.map((skill) => (
          <article class="card-skill" data-category={skill.category}>
            <div class="box-icon-skill">
              <img
                src={skill.icon.src}
                alt={`logo ${skill.name}`}
                class="icons-skills"
              />
            </div>
            <div>
              <h2>{skill.name}</h2>
              <p>{skill.category}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Función para inicializar el filtro
  function initSkillFilter() {
    const skillFilter = document.getElementById(
      "skillFilter"
    ) as HTMLSelectElement;
    const skillsContainer = document.getElementById("skillsContainer");
    const skillCards = document.querySelectorAll(
      ".card-skill"
    ) as NodeListOf<HTMLElement>;

    if (!skillFilter || !skillsContainer) return;

    // Función para filtrar skills con animación
    function filterSkills(selectedCategory: string) {
      skillCards.forEach((card, index) => {
        const category = card.dataset.category;
        const shouldShow =
          selectedCategory === "Todos" || category === selectedCategory;

        if (shouldShow) {
          // Mostrar con animación
          card.style.display = "flex";
          card.style.opacity = "0";
          card.style.transform = "translateY(20px) scale(0.9)";

          // Animación escalonada
          setTimeout(() => {
            card.style.transition = "all 0.4s ease";
            card.style.opacity = "1";
            card.style.transform = "translateY(0) scale(1)";
          }, index * 50); // Retraso progresivo
        } else {
          // Ocultar con animación
          card.style.transition = "all 0.3s ease";
          card.style.opacity = "0";
          card.style.transform = "translateY(-20px) scale(0.9)";

          setTimeout(() => {
            card.style.display = "none";
          }, 300);
        }
      });

      // Actualizar contador (opcional)
      updateSkillCount(selectedCategory);
    }

    // Función para actualizar contador de skills
    function updateSkillCount(category: string) {
      const visibleCount =
        category === "Todos"
          ? skillCards.length
          : Array.from(skillCards).filter(
              (card) => card.dataset.category === category
            ).length;

      // Podrías agregar un elemento para mostrar el conteo
      console.log(`Mostrando ${visibleCount} habilidades`);
    }

    // Event listener para el select
    skillFilter.addEventListener("change", (e) => {
      const target = e.target as HTMLSelectElement;
      const selectedCategory = target.value;

      // Agregar efecto visual al filtro
      skillFilter.style.transform = "scale(0.95)";
      setTimeout(() => {
        skillFilter.style.transform = "scale(1)";
      }, 150);

      filterSkills(selectedCategory);
    });

    // Inicializar mostrando todas las skills
    filterSkills("Todos");
  }

  // Inicializar cuando el DOM esté listo
  document.addEventListener("DOMContentLoaded", initSkillFilter);

  // Para compatibilidad con Astro
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSkillFilter);
  } else {
    initSkillFilter();
  }
</script>

<style>
  section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    align-items: center;
    overflow: hidden;
  }

  .header-skills {
    width: 100%;
    max-width: 1000px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
    padding: 0 10px;
  }

  .box-filters {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(
      45deg,
      rgba(3, 52, 110, 0.1),
      rgba(110, 172, 218, 0.05)
    );
    border-radius: 10px;
    padding: 0.5rem 1.5rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .box-filters:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    transform: translateY(-5px);
  }

  .box-filters label {
    color: var(--color-secondary);
    font-size: 1rem;
  }

  .filters {
    outline: none;
    border-color: var(--color-primary);
    background: transparent;
    border: 1px solid rgba(110, 172, 218, 0.2);
    color: var(--color-text);
    font-size: 1rem;
    padding: 0.5rem 2rem 0.5rem 0.5rem;
    border-radius: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236eacda' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6,9 12,15 18,9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.5rem center;
    background-size: 1rem;
  }

  .filters:hover {
    border-color: rgba(110, 172, 218, 0.4);
    background-color: rgba(9, 36, 58, 0.3);
  }

  .filters:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(110, 172, 218, 0.1);
  }

  .filters option {
    background-color: var(--color-background);
    color: var(--color-text);
    border: none;
  }

  .filters option:hover,
  .filters option:checked {
    background: rgba(110, 172, 218, 0.1);
    color: var(--color-primary);
  }

  h1 {
    color: var(--color-text);
    font-size: 2rem;
  }

  .content-skills {
    max-width: 1000px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-radius: 20px;
    gap: 30px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 20px;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      rgba(3, 52, 110, 0.3) 40%,
      var(--color-background) 100%
    );
    min-height: 400px;
  }

  .card-skill {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    color: white;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    text-align: center;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .card-skill::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.05),
      transparent
    );
    transition: left 0.5s ease;
  }

  .card-skill:hover::before {
    left: 100%;
  }

  .card-skill:hover {
    transform: translateY(-20px);
    border-color: rgba(110, 172, 218, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  h2 {
    color: var(--color-text);
    font-size: 18px;
    width: 100%;
    text-align: center;
    margin: 0.5rem 0;
  }

  .card-skill p {
    color: var(--color-secondary);
    font-size: 14px;
    opacity: 0.8;
    margin: 0;
  }

  .box-icon-skill {
    width: 100%;
    min-height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem 0;
  }

  .icons-skills {
    width: 50px;
    height: 50px;
    filter: invert(1);
    transition: transform 0.3s ease;
  }

  .card-skill:hover .icons-skills {
    transform: scale(1.1) rotate(5deg);
  }

  @media (max-width: 768px) {
    .header-skills {
      flex-direction: column;
      gap: 1rem;
      align-items: stretch;
      text-align: center;
    }

    .box-filters {
      justify-content: center;
    }

    .content-skills {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 20px;
      padding: 15px;
    }
  }
</style>
