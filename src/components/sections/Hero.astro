---
import Logo from "../icons/logo.png";
import linkedin from "../icons/linkedin.svg";
import github from "../icons/github.svg";
---

<section class="hero" id="Hero">
  <div class="hero-content">
    <div class="hero-info">
      <h2>¡HOLA!, mi nombre es:</h2>

      <h1 class="nombre">Victor Danilo Alvarez Alvarez</h1>
      <p>
        Estudiante de ingeniería de sistemas, entusiasta por el desarrollo web.
        ¡Explora mi portafolio y conoce más sobre mi trabajo y proyectos!
      </p>
      <a class="button-cv"
        href="../../assets/files/CV_VDAA.pdf"
        download="CV_VDAA.pdf"
        >Descargar CV
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M18.22 20.75H5.78A2.64 2.64 0 0 1 3.25 18v-3a.75.75 0 0 1 1.5 0v3a1.16 1.16 0 0 0 1 1.25h12.47a1.16 1.16 0 0 0 1-1.25v-3a.75.75 0 0 1 1.5 0v3a2.64 2.64 0 0 1-2.5 2.75"
          ></path><path
            fill="currentColor"
            d="M12 15.75a.74.74 0 0 1-.53-.22l-4-4a.75.75 0 0 1 1.06-1.06L12 13.94l3.47-3.47a.75.75 0 0 1 1.06 1.06l-4 4a.74.74 0 0 1-.53.22"
          ></path><path
            fill="currentColor"
            d="M12 15.75a.76.76 0 0 1-.75-.75V4a.75.75 0 0 1 1.5 0v11a.76.76 0 0 1-.75.75"
          ></path></svg
        >
    </a>
    </div>
    <div class="hero-card">
      <div class="logoBox">
        <img src={Logo.src} alt="logo" class="logoVDAA" />
      </div>
      <div class="box-redes">
        <a
          href="https://www.linkedin.com/in/victor-danilo-alvarez-alvarez-130814330"
          class="redes"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={linkedin.src} alt="Logo de LinkedIn" class="logosRedes" />
        </a>
        <a
          href="https://github.com/V23Dan"
          class="redes"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={github.src} alt="Logo de Github" class="logosRedes" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    min-height: 100vh;
    width: 100%;
    max-width: 1300px;
    justify-content: center;
    align-items: center;
    padding: 20px;
    margin: 0 auto;
  }

  .hero-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  h2 {
    color: var(--color-secondary);
    font-weight: 500;
    font-size: 1.5rem;
  }

  p {
    margin-top: 15px;
    line-height: 1.4;
    font-size: 1.1rem;
  }

  .hero-info {
    width: 50%;
    font-size: 18px;
    color: white;
  }

  .button-cv {
    text-decoration: none;
    max-width: 200px;
    margin-top: 10px;
    padding: 10px 16px;
    background-color: var(--color-background);
    color: var(--color-secondary);
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    border: 1px solid rgba(110, 172, 218, 0.3);
    transition: all 250ms linear;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .button-cv:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary, #6eacda);
    box-shadow: 0 0 15px rgba(110, 172, 218, 0.4);
  }

  .hero-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 40%;
    height: 400px;
    background-color: #09243a;
    border: 1px solid rgba(110, 172, 218, 0.3);
    box-shadow: inset 0 0 20px 2px var(--color-background);
    padding: 15px;
    border-radius: 25px;
    transition: all 400ms linear;
  }

  .hero-card:hover {
    box-shadow: inset 0 0 15px #ffffff;
  }

  .nombre {
    font-size: 2.3rem;
    margin: 10px 0;
    color: var(--color-text);
  }

  .logoVDAA {
    width: 200px;
    height: 200px;
    border-radius: 100%;
    z-index: 2;
  }

  .box-redes {
    width: 100%;
    gap: 25px;
    display: flex;
    justify-content: center;
  }

  .redes {
    width: 40px;
    height: 40px;
    padding: 10px;
    border-radius: 100%;
    transition: all 250ms ease-in-out;
  }

  .logosRedes {
    width: 100%;
    height: 100%;
    filter: invert(1);
  }

  .redes:hover {
    background-color: var(--color-primary);
    translate: 0 -3px;
  }

  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .logoBox {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .logoBox::after,
  .logoBox::before {
    content: "";
    position: absolute;
    height: 200px;
    width: 200px;
    background-image: conic-gradient(
      from var(--angle),
      #03346e,
      #6eacda,
      #e2e2b6
    );
    padding: 3px;
    border-radius: 100%;
    z-index: 1;
    animation: 3s spin linear infinite;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .logoBox::before {
    filter: blur(1.5rem);
    opacity: 0.7;
  }

  @keyframes spin {
    from {
      --angle: 0deg;
    }
    to {
      --angle: 360deg;
    }
  }

  @media (max-width: 1200px) {
    .hero-content {
      max-width: 900px;
    }
  }

  @media (max-width: 900px) {
    .hero-content {
      max-width: 750px;
    }

    .hero-info {
      width: 55%;
    }

    .hero-card {
      width: 45%;
      height: 380px;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 100vh;
    }

    .hero-content {
      flex-direction: column;
      gap: 30px;
      margin-top: 60px;
      max-width: 100%;
      width: 100%;
    }

    .hero-info {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 500px;
      text-align: center;
      justify-content: center;
      font-size: 16px;
    }

    .button-cv {
      width: 40%;
      max-width: 200px;
      margin: 0 auto;
    }

    h2 {
      font-size: 1.3rem;
    }

    .nombre {
      font-size: clamp(1.6rem, 5vw, 2rem);
    }

    p {
      font-size: 1rem;
      line-height: 1.5;
    }

    .hero-card {
      width: 100%;
      max-width: 400px;
      height: auto;
      padding: 25px 15px;
      gap: 20px;
      flex-direction: column;
    }

    .button-cv {
      width: auto;
      padding: 12px 28px;
    }
  }

  @media (max-width: 500px) {
    .hero-content {
      margin-top: 50px;
    }

    .hero-info {
      width: 100%;
    }

    h2 {
      font-size: 1.2rem;
    }

    .nombre {
      font-size: 1.6rem;
    }

    p {
      font-size: 0.95rem;
      margin-top: 12px;
    }

    .button-cv {
      font-size: 15px;
      padding: 10px 24px;
    }

    .hero-card {
      max-width: 350px;
      padding: 20px 15px;
    }
  }

  @media (max-width: 400px) {
    .hero-content {
      margin-top: 40px;
    }

    .logoBox {
      width: 150px;
      height: 150px;
    }

    .logoBox::after,
    .logoBox::before {
      width: 150px;
      height: 150px;
    }

    .logoVDAA {
      width: 150px;
      height: 150px;
    }

    .hero-card {
      max-width: 300px;
    }

    .box-redes {
      gap: 20px;
    }

    .redes {
      width: 35px;
      height: 35px;
    }
  }
</style>
