---
import ProyectoVicBank from "../../assets/img/Projects/ProyectoVicBank.png";
import ProyectoSaludIntegral from "../../assets/img/Projects/SaludIntegral.png";
import ProyectoSignTech from "../../assets/img/Projects/SignTech.png";
import IconGithub from "../icons/Github.svg";
import IconLink from "../icons/Link.svg";

import { skills } from "./Skills.astro";

const projects = [
  {
    title: "VicBank",
    description:
      "Sistema de banca en línea robusto. Gestiona autenticación basada en roles, transacciones seguras en tiempo real y administración de cuentas.",
    image: ProyectoVicBank,
    technologies: ["Angular", "Node.js", "PostgreSQL"],
    githubLink: "https://github.com/V23Dan/Project_transaction_VF.git",
  },
  {
    title: "Salud integral",
    description:
      "Plataforma web integral para la gestión de salud y bienestar potenciado con IA. Incluye seguimiento de rutinas, planes nutricionales y métricas corporales. [Sigue en desarrollo]",
    image: ProyectoSaludIntegral,
    technologies: ["Angular", "Node.js", "MongoDB"],
    Link: "https://salud-integral-afa04.web.app",
  },
  {
    title: "SignTech",
    description: "Aplicativo web para reconocimiento de lengua de señas colombiana, detecta alrededor de 55 señas entre letras y palabras, usando un microservicio hecho en python con tensorflow y mediaPipe. Pensado para usar con una Esp32Cam, pero con funcionamiento de camara local de laptop.",
    image: ProyectoSignTech,
    technologies: ["React", "Node.js", "PostgreSQL", "Python"],
    githubLink: "https://github.com/V23Dan/ProyectoElectronica.git",
  }
];

const getSkillByName = (techName: string) => {
  return skills.find((skill) => skill.name === techName);
};
---

<section id="proyectos">
  <div class="space-projects">
    <header class="header-projects">
      <h1>Proyectos</h1>
      <p>Desarrollos recientes</p>
    </header>

    <div class="content-projects">
      {
        projects.map((project) => {
          const projectUrl = project.githubLink || project.Link;

          const isGithub = !!project.githubLink;

          const iconSrc = isGithub ? IconGithub.src : IconLink.src;
          const iconAlt = isGithub ? "GitHub" : "Enlace al sitio";
          const linkTitle = isGithub
            ? "Ver código en GitHub"
            : "Ver proyecto desplegado";

          return (
            <article class="card-project">
              <div class="box-image-project">
                <img
                  src={project.image.src}
                  alt={`Imagen del proyecto ${project.title}`}
                  class="project-img"
                />

                {projectUrl && (
                  <div class="overlay-github">
                    <a
                      href={projectUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-github"
                      title={linkTitle}
                    >
                      <img src={iconSrc} alt={iconAlt} class="git-icon" />
                    </a>
                  </div>
                )}
              </div>

              <div class="project-info-overlay">
                <div class="info-content">
                  <h2>{project.title}</h2>
                  <p class="description">{project.description}</p>

                  <div class="tech-stack-container">
                    <span class="tech-label">Tecnologías:</span>
                    <div class="tech-icons-grid">
                      {project.technologies.map((techName) => {
                        const skillData = getSkillByName(techName);
                        return skillData ? (
                          <div class="tech-badge" title={techName}>
                            <img src={skillData.icon.src} alt={techName} />
                            <span>{techName}</span>
                          </div>
                        ) : (
                          <span class="tech-badge-text">{techName}</span>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  section {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    padding: 20px 15px;
    align-items: center;
  }

  .space-projects {
    width: 100%;
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: center;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .space-projects {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .header-projects {
    width: 100%;
    text-align: center;
    color: var(--color-text);
  }

  @media (min-width: 1024px) {
    .header-projects {
      width: 20%;
      text-align: left;
      padding-top: 20px;
    }
  }

  .header-projects h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .header-projects p {
    color: var(--color-secondary);
    opacity: 0.8;
    font-size: clamp(0.9rem, 2vw, 1rem);
  }

  .content-projects {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 15px;
    background: #09243a;
    border-radius: 15px;
    border: 1px solid rgba(110, 172, 218, 0.3);
    box-shadow: inset 0 0 20px 2px var(--color-background);
  }

  @media (min-width: 640px) {
    .content-projects {
      padding: 25px;
      gap: 25px;
      border-radius: 20px;
    }
  }

  @media (min-width: 1024px) {
    .content-projects {
      width: 80%;
      padding: 30px;
      gap: 30px;
    }
  }

  .card-project {
    width: 100%;
    height: 250px;
    border-radius: 15px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.4s ease;
  }

  @media (min-width: 640px) {
    .card-project {
      height: 280px;
      border-radius: 20px;
    }
  }

  @media (min-width: 768px) {
    .card-project {
      height: 300px;
    }
  }

  .card-project:hover {
    border-color: rgba(110, 172, 218, 0.5);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .box-image-project {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-project:hover .project-img,
  .card-project:active .project-img {
    transform: scale(1.05);
    filter: blur(4px) brightness(0.6);
  }

  .overlay-github {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 20;
  }

  @media (min-width: 640px) {
    .overlay-github {
      top: 15px;
      right: 15px;
    }
  }

  .btn-github {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(9, 36, 58, 0.8);
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  @media (min-width: 640px) {
    .btn-github {
      width: 45px;
      height: 45px;
    }
  }

  .btn-github:hover {
    transform: scale(1.1);
    border-color: var(--color-primary, #6eacda);
    box-shadow: 0 0 15px rgba(110, 172, 218, 0.4);
  }

  .git-icon {
    width: 20px;
    height: 20px;
    filter: invert(1);
  }

  @media (min-width: 640px) {
    .git-icon {
      width: 24px;
      height: 24px;
    }
  }

  .project-info-overlay {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 15px;
    background: linear-gradient(to top, rgba(7, 31, 50, 0.9), transparent);
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.4s ease-in-out;
    overflow-y: auto;
    overflow-x: hidden;
  }

  @media (min-width: 640px) {
    .project-info-overlay {
      padding: 20px;
    }
  }

  .card-project:hover .project-info-overlay,
  .card-project:active .project-info-overlay {
    opacity: 1;
    transform: translateY(0);
    background: rgba(9, 36, 58, 0.92);
    backdrop-filter: blur(5px);
  }

  .info-content {
    width: 100%;
    color: white;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 100%;
  }

  @media (min-width: 640px) {
    .info-content {
      gap: 8px;
    }
  }

  @media (min-width: 769px) {
    .info-content {
      gap: 10px;
    }
  }

  .info-content h2 {
    font-size: clamp(1.2rem, 4vw, 1.8rem);
    color: var(--color-text, #6eacda);
    margin: 0;
    line-height: 1.2;
  }

  .description {
    font-size: clamp(0.75rem, 2vw, 0.95rem);
    color: #ddd;
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 400px) {
    .description {
      -webkit-line-clamp: 4;
      line-height: 1.4;
    }
  }

  @media (min-width: 640px) {
    .description {
      line-height: 1.5;
    }
  }

  @media (min-width: 769px) {
    .description {
      -webkit-line-clamp: unset;
    }
  }

  .tech-stack-container {
    margin-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 6px;
  }

  @media (min-width: 640px) {
    .tech-stack-container {
      margin-top: 10px;
      padding-top: 10px;
    }
  }

  @media (min-width: 769px) {
    .tech-stack-container {
      margin-top: 15px;
      padding-top: 15px;
    }
  }

  .tech-label {
    font-size: clamp(0.7rem, 1.5vw, 0.8rem);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 8px;
  }

  @media (min-width: 640px) {
    .tech-label {
      margin-bottom: 10px;
    }
  }

  .tech-icons-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (min-width: 640px) {
    .tech-icons-grid {
      gap: 12px;
    }
  }

  @media (min-width: 769px) {
    .tech-icons-grid {
      gap: 15px;
    }
  }

  .tech-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.3s;
  }

  @media (min-width: 640px) {
    .tech-badge {
      padding: 6px 12px;
      border-radius: 8px;
      gap: 8px;
    }
  }

  .tech-badge:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(110, 172, 218, 0.4);
  }

  .tech-badge img {
    width: 18px;
    height: 18px;
    filter: invert(1);
  }

  @media (min-width: 640px) {
    .tech-badge img {
      width: 20px;
      height: 20px;
    }
  }

  .tech-badge span {
    font-size: clamp(0.75rem, 1.8vw, 0.85rem);
    font-weight: 500;
  }

  .tech-badge-text {
    background: rgba(110, 172, 218, 0.1);
    color: #6eacda;
    padding: 4px 8px;
    border-radius: 5px;
    font-size: clamp(0.7rem, 1.5vw, 0.8rem);
  }

  @media (min-width: 640px) {
    .tech-badge-text {
      padding: 5px 10px;
    }
  }
</style>